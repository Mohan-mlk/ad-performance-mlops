# Keep the public tracking service small enough for Render's free instance.
# The API and dashboard continue to use the full project image.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app/src PYTHONHASHSEED=0
WORKDIR /app

# Keep the tracker lightweight while adding the project's data readers and
# Parquet engine so its seed run can register real dataset inputs.
RUN pip install --no-cache-dir \
    "mlflow==2.10.2" "sqlalchemy<2.1" \
    "numpy>=1.26,<2" "pandas>=2.2,<3" "pyarrow>=15,<22" "PyYAML>=6"

COPY scripts/start-mlflow.sh ./scripts/start-mlflow.sh
COPY scripts/seed-mlflow-on-start.py ./scripts/seed-mlflow-on-start.py
COPY src/ ./src/
COPY params.yaml ./params.yaml
COPY artifacts/ ./artifacts/
COPY data/reference/ ./data/reference/

# The hosted run should use the same reproducible, synthetic project data as
# training. Generate it inside the image because raw and weekly data are DVC
# outputs and are intentionally not stored in Git.
RUN python -m adperf.data.generate --rows 24000 --seed 42 \
    && ADPERF_HISTORY_WINDOW=12 python -m adperf.features.build

RUN useradd -m -u 10001 appuser \
    && mkdir -p /tmp/mlflow/artifacts \
    && chown -R appuser:appuser /app /tmp/mlflow

USER appuser
EXPOSE 5000
CMD ["sh", "scripts/start-mlflow.sh"]
